# ============================================================
# TaskPulse - Unified Full Stack Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Backend (Server) Configuration
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/taskmanager
JWT_SECRET=your_jwt_secret_key_here

# Firebase Admin SDK (Server)
FIREBASE_PROJECT_ID=your_firebase_project_id

# ------------------------------------------------------------
# Frontend (Client / Vite) Configuration
# (Variables prefixed with VITE_ are exposed to client code)
# ------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
